{
  "$schema": "./polycode.config.schema.json",
  "defaultMode": "smart-auto",
  "promptEngineer": {
    "enabled": true,
    "agentKey": "copilot",
    "systemPrompt": "You are a prompt engineer. Compress and restructure the user's instruction into a concise, unambiguous, single-paragraph directive for a coding agent. Remove fluff. Keep all hard requirements, constraints, and deliverables. Output ONLY the optimized prompt, no preamble.",
    "timeoutMs": 30000
  },
  "agents": {
    "copilot": {
      "name": "copilot",
      "costBadge": "OPT",
      "description": "Prompt optimizer — Command Code Qwen 3.8 27B.",
      "cmdTemplate": "cmdc -p \"{prompt}\" -m qwen-3.8-27b",
      "tags": ["optimize", "compress", "prompt-engineering"]
    },
    "architect": {
      "name": "architect",
      "costBadge": "PLAN",
      "description": "High-level planner — agy.exe Claude Opus 4.6.",
      "cmdTemplate": "agy.exe -p \"{prompt}\" -m claude-opus-4.6",
      "tags": ["design", "architecture", "system", "plan", "complex", "reasoning", "migrate", "secure"]
    },
    "builder": {
      "name": "builder",
      "costBadge": "BUILD",
      "description": "Build agent — Command Code Mimov2.5 Pro.",
      "cmdTemplate": "cmdc -p \"{prompt}\" -m mimov2.5-pro",
      "tags": ["build", "implement", "feature", "code", "scaffold", "api", "endpoint"]
    },
    "workhorse-flash": {
      "name": "workhorse-flash",
      "costBadge": "WORK",
      "description": "Fast execution — agy.exe 3.7 Flash.",
      "cmdTemplate": "agy.exe -p \"{prompt}\" -m 3.7-flash",
      "tags": ["fast", "quick", "simple", "fix", "typo", "rapid", "hello", "test", "run"]
    },
    "workhorse-ox": {
      "name": "workhorse-ox",
      "costBadge": "WORK",
      "description": "Heavy-lifting — Command Code ox-alpha.",
      "cmdTemplate": "cmdc -p \"{prompt}\" -m ox-alpha",
      "tags": ["heavy", "large", "refactor", "multi-file", "deep-edit", "complex", "rewrite"]
    },
    "workhorse-deepseek": {
      "name": "workhorse-deepseek",
      "costBadge": "WORK",
      "description": "Deep reasoning — DeepSeek V4 Flash latest.",
      "cmdTemplate": "cmdc -p \"{prompt}\" -m deepseek-v4-flash",
      "tags": ["reasoning", "logic", "algorithm", "math", "analysis", "debug", "optimize"]
    },
    "auditor": {
      "name": "auditor",
      "costBadge": "AUDIT",
      "description": "Review/audit — codex GPT 5.6 Terra Medium.",
      "cmdTemplate": "codex -p \"{prompt}\" -m gpt-5.6-terra-medium",
      "tags": ["review", "audit", "test", "verify", "security", "lint", "check"]
    }
  },
  "tiers": [
    {
      "id": "quick",
      "name": "Quick",
      "color": "green",
      "costBadge": "L",
      "agentKey": "workhorse-flash",
      "maxWords": 15,
      "keywords": ["fix", "typo", "hello", "hi", "test", "run"]
    },
    {
      "id": "standard",
      "name": "Standard",
      "color": "yellow",
      "costBadge": "M",
      "agentKey": "builder",
      "maxWords": null,
      "keywords": ["feature", "add", "refactor", "build", "api", "endpoint"]
    },
    {
      "id": "complex",
      "name": "Complex",
      "color": "red",
      "costBadge": "H",
      "agentKey": "architect",
      "maxWords": null,
      "keywords": ["architect", "design", "system", "migrate", "secure", "plan"]
    }
  ],
  "swarms": {
    "full-pipeline": {
      "type": "sequential",
      "name": "Full Pipeline",
      "stages": [
        { "agentKey": "architect", "name": "Plan", "cmd": "agy.exe -p \"{prompt}\" -m claude-opus-4.6" },
        { "agentKey": "builder", "name": "Build", "cmd": "cmdc -p \"{prompt}\" -m mimov2.5-pro" },
        { "agentKey": "auditor", "name": "Audit", "cmd": "codex -p \"{prompt}\" -m gpt-5.6-terra-medium" }
      ]
    },
    "parallel-tri-agent": {
      "type": "parallel",
      "name": "Parallel Tri-Agent",
      "subagents": [
        {
          "id": "p1",
          "agentKey": "architect",
          "name": "Design",
          "taskTemplate": "Design a solution for: {prompt}"
        },
        {
          "id": "p2",
          "agentKey": "builder",
          "name": "Implement",
          "taskTemplate": "Implement the fastest correct solution for: {prompt}"
        },
        {
          "id": "p3",
          "agentKey": "auditor",
          "name": "Audit",
          "taskTemplate": "Audit and harden this plan for: {prompt}"
        }
      ]
    },
    "workhorse-swarm": {
      "type": "parallel",
      "name": "Workhorse Swarm",
      "subagents": [
        {
          "id": "w1",
          "agentKey": "workhorse-flash",
          "name": "Flash",
          "taskTemplate": "Execute quickly: {prompt}"
        },
        {
          "id": "w2",
          "agentKey": "workhorse-ox",
          "name": "Ox",
          "taskTemplate": "Deep execute: {prompt}"
        },
        {
          "id": "w3",
          "agentKey": "workhorse-deepseek",
          "name": "DeepSeek",
          "taskTemplate": "Reason through: {prompt}"
        }
      ]
    }
  }
}